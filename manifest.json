{
  "manifest_version": 3,
  "name": "Element Remover",
  "version": "1.0",
  "description": "Select and remove elements from any webpage",
  "action": {
    "default_title": "Element Remover"
  },
  "permissions": ["activeTab", "scripting"],
  "background": {
    "service_worker": "background.js"
  }
}